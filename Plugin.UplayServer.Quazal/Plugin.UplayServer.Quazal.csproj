<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
  </PropertyGroup>

	<ItemGroup>
	  <PackageReference Include="ServerEmus.ServerShared" Version="0.0.16" PrivateAssets="all" ExcludeAssets="runtime" ReferenceOutputAssembly="false" Private="true">
		  <IncludeAssets>compile; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
	  </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="BouncyCastle.Cryptography" Version="2.6.2" />

  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Plugin.UplayServer.Quazal.Tests" />
    <InternalsVisibleTo Include="GameClientTestHarness" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="ModdableWebServer" />
    <Using Include="ModdableWebServer.Attributes" />
    <Using Include="ModdableWebServer.Helper" />
    <Using Include="ModdableWebServer.Senders" />
    <Using Include="System.Text.Json" />
    <Using Include="Serilog" />
  </ItemGroup>

</Project>
